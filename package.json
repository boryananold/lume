{
  "name": "lume-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@expo-google-fonts/lato": "^0.4.1",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/metro-runtime": "^55.0.9",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/stack": "^7.8.10",
    "@supabase/supabase-js": "^2.103.3",
    "expo": "~54.0.33",
    "expo-asset": "^55.0.15",
    "expo-camera": "^55.0.15",
    "expo-constants": "^55.0.14",
    "expo-font": "^55.0.6",
    "expo-linking": "^55.0.13",
    "expo-notifications": "^55.0.19",
    "expo-router": "^55.0.12",
    "expo-secure-store": "^55.0.13",
    "expo-splash-screen": "^55.0.18",
    "expo-status-bar": "~3.0.9",
    "mixpanel-react-native": "^3.3.0",
    "openai": "^6.34.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.31.1",
    "react-native-purchases": "^10.0.1",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^55.0.17",
    "jest": "^30.3.0",
    "jest-expo": "^55.0.16",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(ts|tsx|js|jsx)$": "babel-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testMatch": [
      "**/__tests__/**/*.(ts|tsx|js)",
      "**/?(*.)+(spec|test).(ts|tsx|js)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  }
}
