{
  "expo": {
    "name": "Lumé",
    "slug": "lume-app",
    "version": "1.0.0",
    "scheme": "lume",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F3EE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lume.app"
    },
    "android": {
      "package": "com.lume.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F3EE"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Lumé uses your camera for your daily skin check-in."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C9A96E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "georgi.shulev",
    "extra": {
      "OPENAI_API_KEY": "",
      "SUPABASE_URL": "",
      "SUPABASE_ANON_KEY": "",
      "REVENUECAT_API_KEY": "",
      "BRAZE_API_KEY": "",
      "BRAZE_ENDPOINT": "",
      "MIXPANEL_TOKEN": "",
      "ROBOFLOW_API_KEY": "",
      "router": {},
      "eas": {
        "projectId": "0fcb839b-94d8-458f-acde-a2efd0d257f8"
      }
    }
  }
}
